{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "index": {
      "max_ngram_diff": 6
    },
    "analysis": {
      "char_filter": {
        "html_strip_cf": {
          "type": "html_strip"
        }
      },
      "filter": {
        "filter_ngrams": {
          "type": "ngram",
          "min_gram": 3,
          "max_gram": 6
        },
        "filter_shingles": {
          "type": "shingle",
          "min_shingle_size": 2,
          "max_shingle_size": 2,
          "token_separator": ""
        },
        "possessive_english_stemmer": {
          "type": "stemmer",
          "language": "possessive_english"
        },
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stemmer": {
          "type": "stemmer",
          "language": "english"
        }
      },
      "analyzer": {
        "englando": {
          "type": "custom",
          "char_filter": ["html_strip"],
          "tokenizer": "standard",
          "filter": [
            "possessive_english_stemmer",
            "lowercase",
            "english_stop",
            "english_stemmer"
          ]
        },
        "custom_ngram": {
          "type": "custom",
          "char_filter": ["html_strip"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "filter_ngrams"]
        },
        "custom_shingles": {
          "type": "custom",
          "char_filter": ["html_strip"],
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "filter_shingles"]
        }
      }
    }
  }
}
